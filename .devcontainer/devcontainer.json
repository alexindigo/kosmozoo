{
  "name": "kosmozoo",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "runArgs": [
    "--memory=4g",
    "--memory-swap=4g",
    "--pids-limit=256",
    "--cpus=2"
  ],
  // Run as the image's non-root user; updateRemoteUserUID rewrites the
  // container user's uid/gid to the host user's, so everything written
  // through the workspace mount is owned by the local user — never root.
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "forwardPorts": [2084],
  "customizations": {
    "vscode": {
      "extensions": ["denoland.vscode-deno"]
    }
  }
}
